<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background">

    <LinearLayout
        android:id="@+id/searchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="44dp"
        android:paddingTop="28dp"
        android:paddingEnd="44dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CINE TVMAN"
                android:textColor="@color/tv_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Buscar películas y series"
                android:textColor="@color/tv_text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_tv_player_control"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_ios_search"
                app:tint="@color/tv_accent" />
            <EditText
                android:id="@+id/edtCineSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="Buscar películas y series, no canales"
                android:hint="Título, actor o director..."
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="@color/tv_text_muted"
                android:textSize="17sp" />
            <ImageView
                android:id="@+id/btnCineSearchClear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tv_player_control"
                android:contentDescription="Limpiar búsqueda"
                android:focusable="true"
                android:foreground="@drawable/tv_focus_ring"
                android:padding="13dp"
                android:src="@drawable/ic_ios_xmark"
                android:visibility="gone"
                app:tint="@color/tv_text_muted" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchWorkspace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/searchHeader"
        app:layout_constraintBottom_toTopOf="@id/btnSearchCancel">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="34dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Usa la cruceta y pulsa OK para escribir"
                android:textColor="@color/tv_text_muted"
                android:textSize="13sp" />
            <com.tvman.app.TvRemoteKeyboardView
                android:id="@+id/tvCineSearchKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/contentSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.95"
            android:background="@drawable/bg_tv_playback_panel">
            <ScrollView
                android:id="@+id/scrollIdle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:padding="22dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Búsquedas recientes"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/btnClearHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/tv_focus_ring"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="Limpiar"
                            android:textColor="@color/tv_accent"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/txtHistoryEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tus búsquedas recientes aparecerán aquí"
                        android:textColor="@color/tv_text_muted"
                        android:textSize="14sp"
                        android:visibility="gone" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCineSearchHistory"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="true"
                        android:overScrollMode="never"
                        android:scrollbars="none" />
                    <TextView
                        android:id="@+id/txtPopularTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="9dp"
                        android:text="Búsquedas populares"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCinePopular"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="true"
                        android:overScrollMode="never"
                        android:scrollbars="none" />
                </LinearLayout>
            </ScrollView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCineResults"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone" />
            <TextView
                android:id="@+id/txtResultsEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:padding="24dp"
                android:text="Sin resultados para tu búsqueda"
                android:textColor="@color/tv_text_muted"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnSearchCancel"
        android:layout_width="190dp"
        android:layout_height="54dp"
        android:layout_marginEnd="44dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_tv_player_control"
        android:clickable="true"
        android:contentDescription="Volver a la pantalla anterior"
        android:focusable="true"
        android:foreground="@drawable/tv_focus_ring"
        android:gravity="center"
        android:text="VOLVER"
        android:textColor="@color/tv_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
