<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background">

    <LinearLayout
        android:id="@+id/watchHistHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="26dp"
        android:paddingEnd="32dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btnWatchHistBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tv_player_control"
            android:clickable="true"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back_chevron"
            android:contentDescription="Volver"
            app:tint="@color/tv_text_primary" />
        <TextView
            android:id="@+id/txtWatchHistTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Continuar viendo e historial"
            android:textColor="@color/tv_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnWatchHistEdit"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_tv_player_control"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Limpiar historial"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/historyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/watchHistHeader"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="28dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continuar viendo"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWatchHistory"
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />
            <TextView
                android:id="@+id/txtContinueEmpty"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:text="No hay películas o series pendientes."
                android:textColor="@color/tv_text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtChannelHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Historial de canales"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannelHistory"
                android:layout_width="match_parent"
                android:layout_height="174dp"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />
            <TextView
                android:id="@+id/txtChannelHistoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:text="No hay canales reproducidos recientemente."
                android:textColor="@color/tv_text_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
