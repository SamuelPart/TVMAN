<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/tvPlayerTopScrim"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_tv_player_top_scrim"
        android:visibility="invisible" />

    <View
        android:id="@+id/tvPlayerBottomScrim"
        android:layout_width="match_parent"
        android:layout_height="390dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_tv_player_bottom_scrim"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/tvPlayerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="46dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible">

        <TextView
            android:id="@+id/btnTvPlayerClose"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_tv_player_control"
            android:clickable="true"
            android:contentDescription="Cerrar reproductor"
            android:focusable="true"
            android:nextFocusDown="@id/tvPlayerSeekBar"
            android:foreground="@drawable/tv_focus_ring"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtTvPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Reproduciendo"
                android:textColor="#FFF7F9FC"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtTvPlayerSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFB9C5D4"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlayerLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tv_player_live_badge"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="EN VIVO"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtTvPlayerSeekFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_tv_player_control"
        android:elevation="12dp"
        android:paddingStart="22dp"
        android:paddingTop="13dp"
        android:paddingEnd="22dp"
        android:paddingBottom="13dp"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tvPlayerBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_tv_playback_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtTvPlayerPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0:00"
                android:textColor="#FFF7F9FC"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/tvPlayerSeekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:contentDescription="Posición de reproducción. Izquierda y derecha para buscar"
                android:focusable="true"
                android:max="1000"
                android:nextFocusDown="@id/btnTvPlayerPlayPause"
                android:minHeight="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressBackgroundTint="#668594A8"
                android:progressTint="#FF68D9D5"
                android:secondaryProgressTint="#AA68D9D5"
                android:thumbTint="#FFFFFFFF" />
            <TextView
                android:id="@+id/txtTvPlayerDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0:00"
                android:textColor="#FFB9C5D4"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvPlayerActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnTvPlayerRewind"
                android:layout_width="64dp"
                android:layout_height="58dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_tv_player_control"
                android:clickable="true"
                android:contentDescription="Retroceder diez segundos"
                android:focusable="true"
                android:foreground="@drawable/tv_focus_ring"
                android:gravity="center"
                android:nextFocusUp="@id/tvPlayerSeekBar"
                android:text="−10"
                android:textColor="#FFF7F9FC"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnTvPlayerPlayPause"
                android:layout_width="78dp"
                android:layout_height="64dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/tv_play_button"
                android:clickable="true"
                android:contentDescription="Reproducir o pausar"
                android:focusable="true"
                android:foreground="@drawable/tv_focus_ring"
                android:gravity="center"
                android:nextFocusUp="@id/tvPlayerSeekBar"
                android:text="Ⅱ"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnTvPlayerForward"
                android:layout_width="64dp"
                android:layout_height="58dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tv_player_control"
                android:clickable="true"
                android:contentDescription="Avanzar diez segundos"
                android:focusable="true"
                android:foreground="@drawable/tv_focus_ring"
                android:gravity="center"
                android:nextFocusUp="@id/tvPlayerSeekBar"
                android:text="+10"
                android:textColor="#FFF7F9FC"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnTvPlayerOptions"
                android:layout_width="96dp"
                android:layout_height="58dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_tv_player_control"
                android:clickable="true"
                android:contentDescription="Opciones de reproducción: subtítulos, audio, velocidad y transmisión"
                android:focusable="true"
                android:foreground="@drawable/tv_focus_ring"
                android:gravity="center"
                android:nextFocusUp="@id/tvPlayerSeekBar"
                android:text="OPCIONES"
                android:textColor="#FFDCE5F2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
