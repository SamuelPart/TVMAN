<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_sidebar"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="22dp"
    android:paddingBottom="16dp"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/sideBrandRow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/sideBrandIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="TVMAN"
            android:src="@drawable/ic_tvman" />
        <TextView
            android:id="@+id/sideBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="TVMAN"
            android:textColor="@color/tv_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <Space
            android:id="@+id/sideBrandSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <ImageButton
            android:id="@+id/sideCollapseButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_tv_sidebar_item"
            android:contentDescription="Contraer navegación"
            android:rotation="180"
            android:src="@drawable/ic_ios_arrow_right"
            android:tint="@color/tv_nav_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sideProfile"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <TextView
            android:id="@+id/sideProfileInitial"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_profile_avatar"
            android:gravity="center"
            android:text="U"
            android:textColor="#FF101421"
            android:textSize="18sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/sideProfileDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/sideProfileCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="@color/tv_text_muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/sideProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Usuario"
                android:textColor="@color/tv_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sideSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/bg_chip_ios"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">
        <ImageButton
            android:id="@+id/sideSearchAction"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Buscar"
            android:src="@drawable/ic_ios_search"
            android:tint="@color/tv_nav_accent" />
        <EditText
            android:id="@+id/sideSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tv_sidebar_search_input"
            android:hint="Buscar películas"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="5dp"
            android:paddingEnd="2dp"
            android:textColor="@color/tv_text_primary"
            android:textColorHint="@color/tv_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView android:id="@+id/sideSectionMenu" style="@style/TvSidebarSection" android:text="MENÚ" />
            <TextView android:id="@+id/sideNavHome" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_ios_home" android:text="Inicio" android:contentDescription="Inicio" />
            <TextView android:id="@+id/sideNavContinue" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_ios_clock" android:text="Continuar viendo" android:contentDescription="Continuar viendo" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp">
                <TextView
                    android:id="@+id/sideNavMyList"
                    style="@style/TvSidebarItem"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical"
                    android:drawableStart="@drawable/ic_ios_star"
                    android:text="Mi lista"
                    android:contentDescription="Mi lista" />
                <TextView
                    android:id="@+id/sideMyListBadge"
                    android:layout_width="wrap_content"
                    android:minWidth="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_tv_sidebar_badge"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="0"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/sideNavChannels" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_ios_tv" android:text="Canales" android:contentDescription="Canales" />
            <TextView android:id="@+id/sideNavSeries" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_nav_cine" android:text="Series" android:contentDescription="Series" />
            <TextView android:id="@+id/sideNavMovies" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_ios_movie" android:text="Películas" android:contentDescription="Películas" />
            <TextView android:id="@+id/sideNavGames" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_sidebar_games" android:text="Juegos" android:contentDescription="Juegos" />

            <TextView android:id="@+id/sideSectionTrend" style="@style/TvSidebarSection" android:text="DISCOVERY" />
            <TextView android:id="@+id/sideNavReleases" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_ios_refresh" android:text="Estrenos" android:contentDescription="Estrenos" />
            <TextView android:id="@+id/sideNavPopular" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_ios_star_fill" android:text="Popular" android:contentDescription="Popular" />

            <TextView android:id="@+id/sideSectionGeneral" style="@style/TvSidebarSection" android:text="GENERAL" />
            <TextView android:id="@+id/sideNavSettings" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_ios_gear" android:text="Ajustes" android:contentDescription="Ajustes" />
            <TextView android:id="@+id/sideNavExit" style="@style/TvSidebarItem" android:drawableStart="@drawable/ic_sidebar_exit" android:text="Cerrar sesión" android:contentDescription="Cerrar sesión" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
