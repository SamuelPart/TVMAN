<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/homeToolbar"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="72dp"
        android:paddingEnd="34dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_tvman"
            android:contentDescription="TVMAN" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="TVMAN"
            android:textColor="#E5E5E8"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/homeSearch"
            style="@style/TvHomeToolbarIcon"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Buscar"
            android:src="@drawable/ic_ios_search" />
        <ImageView
            style="@style/TvHomeToolbarIcon"
            android:contentDescription="Filtros"
            android:src="@drawable/ic_ios_filter" />
        <ImageView
            style="@style/TvHomeToolbarIcon"
            android:contentDescription="Vista de catálogo"
            android:src="@drawable/ic_ios_grid" />
        <ImageView
            style="@style/TvHomeToolbarIcon"
            android:contentDescription="Perfil"
            android:src="@drawable/ic_tv_profile" />
        <ImageView
            style="@style/TvHomeToolbarIcon"
            android:contentDescription="Notificaciones"
            android:src="@drawable/ic_tv_bell" />
        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="14dp"
            android:background="#4DFFFFFF" />
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="3dp"
            android:contentDescription="Estado de Wi-Fi"
            android:src="@drawable/ic_tv_wifi"
            android:tint="#77777D" />
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="18dp"
            android:padding="3dp"
            android:contentDescription="Pantalla"
            android:src="@drawable/ic_cast"
            android:tint="#77777D" />
        <TextClock
            android:id="@+id/tvHomeClock"
            android:layout_width="116dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical|end"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#F1F1F2"
            android:textSize="19sp"
            android:contentDescription="Hora local" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homeBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/homeSidebar"
            android:layout_width="188dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">
            <TextView android:id="@+id/navTv" style="@style/TvHomeNavItem" android:drawableStart="@drawable/ic_ios_tv" android:text="TV" />
            <TextView android:id="@+id/navFeatured" style="@style/TvHomeNavItem" android:drawableStart="@drawable/ic_ios_star_fill" android:text="DESTACADO.." />
            <TextView android:id="@+id/navMovies" style="@style/TvHomeNavItem" android:drawableStart="@drawable/ic_ios_movie" android:text="PELÍCULAS" />
            <TextView android:id="@+id/navSeries" style="@style/TvHomeNavItem" android:drawableStart="@drawable/ic_ios_tv" android:text="SERIES" />
            <TextView android:id="@+id/navKids" style="@style/TvHomeNavItem" android:drawableStart="@drawable/ic_ios_home" android:text="KIDS" />
            <TextView android:id="@+id/navAnime" style="@style/TvHomeNavItem" android:drawableStart="@drawable/ic_ios_photo" android:text="ANIME" />
            <TextView android:id="@+id/navExplore" style="@style/TvHomeNavItem" android:drawableStart="@drawable/ic_ios_globe" android:text="EXPLORAR" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeArtworkGrid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/homeFeaturedRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.66"
                android:orientation="horizontal" />
            <LinearLayout
                android:id="@+id/homePosterRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="0.34"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
