<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tvRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:id="@+id/tvPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="0dp"
        android:background="@android:color/transparent"
        android:clipToOutline="false">

        <ImageView
            android:id="@+id/tvBackdrop"
            android:layout_width="match_parent"
            android:layout_height="470dp"
            android:contentDescription="Imagen de fondo del título destacado"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tv_home_scrim" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tv_hero_left_scrim" />

        <ScrollView
            android:id="@+id/tvContentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="166dp"
            android:paddingEnd="64dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:id="@+id/tvHeroInfo"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingTop="18dp">

                    <TextView android:id="@+id/tvHeroEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INICIO" android:textColor="#66E0C2" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" android:visibility="gone" />
                    <TextView android:id="@+id/tvHeroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:maxLines="2" android:ellipsize="end" android:text="" android:textColor="#FFFFFFFF" android:textSize="31sp" android:lineSpacingExtra="-2dp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvHeroMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Películas y series · En TVMAN" android:textColor="#FFD9E0E3" android:textSize="13sp" />
                    <TextView android:id="@+id/tvHeroDescription" android:layout_width="530dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:text="Tus películas, series y canales favoritos." android:textColor="#FFE1E7E8" android:textSize="14sp" android:lineSpacingExtra="3dp" android:visibility="gone" />

                    <LinearLayout android:id="@+id/tvHeroActions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/tvHeroPlay" android:layout_width="124dp" android:layout_height="44dp" android:background="@drawable/tv_play_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="▶   Reproducir" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:contentDescription="Reproducir título destacado" />
                        <TextView android:id="@+id/tvHeroAdd" android:layout_width="112dp" android:layout_height="44dp" android:layout_marginStart="10dp" android:background="@drawable/tv_add_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="＋   Mi lista" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:contentDescription="Añadir a Mi lista" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvContinueTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Continuar viendo"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvContinueAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:text="Ver todo  ›"
                        android:textColor="#FFD3D8DD"
                        android:textSize="12sp" />
                </LinearLayout>
                <HorizontalScrollView
                    android:id="@+id/tvContinueScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/tvContinueRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/tvHomeSections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/tvSectionRecommendations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:id="@+id/tvPostersTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PARA TI" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.05" />
                            <TextView android:id="@+id/tvPostersHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ver todo   ›" android:textColor="#FFD3D8DD" android:textSize="12sp" />
                        </LinearLayout>
                        <HorizontalScrollView android:id="@+id/tvPosterScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:clipToPadding="false" android:fillViewport="false" android:scrollbars="none">
                            <LinearLayout android:id="@+id/tvPosterRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/tvSectionPopular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvSecondRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LO MÁS VISTO" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.05" />
                        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:clipToPadding="false" android:scrollbars="none">
                            <LinearLayout android:id="@+id/tvPopularRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/tvSectionAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACCIÓN Y AVENTURA" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.05" />
                        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:clipToPadding="false" android:scrollbars="none"><LinearLayout android:id="@+id/tvActionRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/tvSectionSciFi" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CIENCIA FICCIÓN" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.05" />
                        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:clipToPadding="false" android:scrollbars="none"><LinearLayout android:id="@+id/tvSciFiRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/tvSectionFamily" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PARA VER EN FAMILIA" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.05" />
                        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:clipToPadding="false" android:scrollbars="none"><LinearLayout android:id="@+id/tvFamilyRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/tvPosterPreview"
            android:layout_width="390dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="112dp"
            android:layout_marginEnd="64dp"
            android:background="@drawable/tv_preview_panel"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvPosterPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tvPosterPreviewMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFDDE2E8"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvPosterPreviewGenres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#FFC99AFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tvPosterPreviewOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:textColor="#FFCBD1D8"
                android:textSize="14sp"
                android:maxLines="4"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>

    <include
        android:id="@+id/tvTopBar"
        layout="@layout/view_tv_sidebar"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <LinearLayout
        android:id="@+id/tvHomeTopActions"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/tvHomeSearchButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_tv_player_control"
            android:contentDescription="Buscar películas y series"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_ios_search"
            app:tint="@color/tv_text_primary" />
        <TextClock
            android:id="@+id/tvHomeClock"
            android:layout_width="62dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:format24Hour="HH:mm"
            android:format12Hour="HH:mm"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp"
            android:contentDescription="Hora local" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tvCatalogErrorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6080B10"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tv_preview_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">
            <TextView
                android:id="@+id/tvCatalogErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NO SE PUDO CARGAR EL CATÁLOGO"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center" />
            <TextView
                android:id="@+id/tvCatalogErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Comprueba la conexión e inténtalo otra vez."
                android:textColor="#FFCBD1D8"
                android:textSize="16sp"
                android:gravity="center" />
            <TextView
                android:id="@+id/tvCatalogRetry"
                android:layout_width="220dp"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/tv_play_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="REINTENTAR"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Reintentar cargar el catálogo" />
        </LinearLayout>
    </FrameLayout>
    <include
        android:id="@+id/tvCradleLoadingOverlay"
        layout="@layout/activity_tv_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />
</FrameLayout>
