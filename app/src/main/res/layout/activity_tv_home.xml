<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A0B"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:id="@+id/tvPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="22dp"
        android:background="@drawable/tv_home_panel"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/tvBackdrop"
            android:layout_width="match_parent"
            android:layout_height="440dp"
            android:contentDescription="Imagen de fondo del título destacado"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tv_home_scrim" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tv_hero_left_scrim" />

        <ScrollView
            android:id="@+id/tvContentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:id="@+id/tvTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/tvBrand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="30dp" android:text="TVMAN" android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold" android:letterSpacing="0.08" />
                    <TextView android:id="@+id/tvNavHome" style="@style/TvTopNavItem" android:text="INICIO" />
                    <TextView android:id="@+id/tvNavMovies" style="@style/TvTopNavItem" android:text="PELÍCULAS" />
                    <TextView android:id="@+id/tvNavSeries" style="@style/TvTopNavItem" android:text="SERIES" />
                    <TextView android:id="@+id/tvNavKids" style="@style/TvTopNavItem" android:text="INFANTIL" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/tvSearchAction" android:layout_width="52dp" android:layout_height="48dp" android:gravity="center" android:background="@drawable/tv_top_action" android:focusable="true" android:clickable="true" android:text="⌕" android:textColor="#FFFFFFFF" android:textSize="31sp" />
                    <TextView android:id="@+id/tvProfile" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="14dp" android:gravity="center" android:background="@drawable/tv_profile_circle" android:focusable="true" android:clickable="true" android:text="T" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvHeroInfo"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingTop="18dp">

                    <TextView android:id="@+id/tvHeroEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TVMAN ORIGINAL" android:textColor="#66E0C2" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.14" />
                    <TextView android:id="@+id/tvHeroTitle" android:layout_width="560dp" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:maxLines="2" android:ellipsize="end" android:text="DESCUBRE TU PRÓXIMA HISTORIA" android:textColor="#FFFFFFFF" android:textSize="39sp" android:lineSpacingExtra="-2dp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvHeroMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Películas y series · En TVMAN" android:textColor="#FFD9E0E3" android:textSize="13sp" />
                    <TextView android:id="@+id/tvHeroDescription" android:layout_width="530dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:text="Tus películas, series y canales favoritos, en una experiencia hecha para la pantalla grande." android:textColor="#FFE1E7E8" android:textSize="14sp" android:lineSpacingExtra="3dp" />

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/tvHeroPlay" android:layout_width="148dp" android:layout_height="44dp" android:background="@drawable/tv_play_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="▶   REPRODUCIR" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvHeroAdd" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:background="@drawable/tv_add_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="＋" android:textColor="#FFFFFFFF" android:textSize="25sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/tvPostersTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PARA TI" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.05" />
                    <TextView android:id="@+id/tvPostersHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ver todo   ›" android:textColor="#FFD3D8DD" android:textSize="12sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/tvPosterScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:scrollbars="none">
                    <LinearLayout android:id="@+id/tvPosterRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView android:id="@+id/tvSecondRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="LO MÁS VISTO" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.05" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:clipToPadding="false" android:scrollbars="none">
                    <LinearLayout android:id="@+id/tvPopularRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
