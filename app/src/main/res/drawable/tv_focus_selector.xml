    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#E3E9FC"/><stroke android:width="1dp" android:color="#8493EA"/><corners android:radius="16dp"/></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#FFFFFF"/><stroke android:width="1dp" android:color="#E3E7EF"/><corners android:radius="16dp"/></shape></item>
</selector>
