<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFD8C5FF" android:endColor="#FFB792FF" android:type="linear" />
            <stroke android:width="3dp" android:color="#FF7541D8" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFB792FF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFD8C5FF" android:endColor="#FFB792FF" android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
